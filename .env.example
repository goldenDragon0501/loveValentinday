# ───────── Supabase ─────────
# Public (safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Netlify Functions only — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ───────── PayPal ─────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox  # sandbox | production
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ───────── ATH Móvil Business ─────────
# Configure according to official ATH Móvil Business documentation
ATH_MOVIL_PUBLIC_TOKEN=your-ath-public-token
ATH_MOVIL_PRIVATE_TOKEN=your-ath-private-token
ATH_MOVIL_ENVIRONMENT=sandbox  # sandbox | production

# ───────── Zelle ─────────
# Manual verification — configured via admin panel (Configuración tab)
# These are stored in app_settings DB table, not env vars

# ───────── Email (Resend) ─────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=calendario@yourdomain.com
RESEND_FROM_NAME=14 días de dulce amor

# ───────── Admin ─────────
ADMIN_SECRET=your-admin-jwt-secret

# ───────── Scheduled Tasks ─────────
CRON_SECRET=your-cron-secret

# ───────── Application ─────────
PUBLIC_URL=https://lovevalentinday.netlify.app
CALENDAR_YEAR=2027
CALENDAR_OPEN_HOUR=8
CALENDAR_TIMEZONE=America/Puerto_Rico
