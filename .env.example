# ═══════════════════════════════════════════
# 14 días de dulce amor — Variables de entorno
# Phase 9: modelo de ventas manuales
# ═══════════════════════════════════════════

# ───────── Supabase (REQUERIDO) ─────────
# Public (safe for frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Netlify Functions only — never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ───────── Admin ─────────
ADMIN_SECRET=your-admin-jwt-secret

# ───────── Email (Resend) — opcional ─────────
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=calendario@yourdomain.com
RESEND_FROM_NAME=14 días de dulce amor

# ───────── Application ─────────
PUBLIC_URL=https://lovevalentinday.netlify.app
CRON_SECRET=your-cron-secret

# ═══════════════════════════════════════════
# DESHABILITADO — pagos automáticos (Phase 9)
# Las siguientes variables ya no son necesarias
# para el funcionamiento del sitio. Preservadas
# por si se reactivan en el futuro.
# ═══════════════════════════════════════════

